# Committed official source samples are hashed over LF content. Without this,
# core.autocrlf rewrites them to CRLF on a Windows checkout and every recorded
# SHA-256 mismatches on a fresh clone while still matching on Linux CI. Hashing
# applies only to officialSources localSamplePath entries; synthetic datasets
# are authored rather than derived and carry no hash, but are pinned here too so
# their diffs stay readable across platforms.
content/playbooks/**/fixtures/** text eol=lf
content/playbooks/**/*.data.json text eol=lf
